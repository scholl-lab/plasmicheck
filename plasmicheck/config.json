{
  "required_tools": ["minimap2", "samtools"],
  "required_python_packages": ["Bio", "pysam", "jinja2", "matplotlib"],
  "resistance_gene_patterns": [],
  "filter_backbone_only": true,
  "score_margin": 0,
  "breadth_thresholds": [5],
  "default_threshold": 0.8,
  "unclear_range": {
    "lower_bound": 0.6,
    "upper_bound": 1.0
  },
  "shift_bases": 500,
  "padding": 1000,
  "scoring": {
    "mate_bonus": 10,
    "clipping_penalty": 1,
    "mismatch_penalty": 1
  },
  "alignment": {
    "minimap2_threads": 8,
    "samtools_threads": 4,
    "samtools_sort_memory": "2G",
    "fasta_extensions": [".fasta", ".fa", ".fna", ".fsa", ".ffn"]
  },
  "indexing": {
    "minimap2_options": ["-d"],
    "samtools_options": []
  },
  "conversion": {
    "input_formats": ["genbank", "xdna", "snapgene"],
    "output_formats": ["fasta", "genbank"]
  },
  "plot_summary": {
    "output_filename": "contamination_heatmap.png",
    "round_decimals": 3,
    "log_offset": 1e-9,
    "marker_style": {
      "size": 8,
      "opacity": 0.7
    },
    "depth_heatmap_cap": 100
  },
  "plot_sample_report": {
    "figsize": {
      "width": 1000,
      "height": 400
    },
    "scatter_plot_x_label": "Plasmid Score",
    "scatter_plot_y_label": "Human Score",
    "box_plot_y_label": "Plasmid Score",
    "output_box_plot_filename": "box_plot.png",
    "output_scatter_plot_filename": "scatter_plot.png",
    "max_rows_for_interactive_plots": 5000
  },
  "paths": {
    "template_dir": "templates",
    "logo_path": "static/img/plasmicheck_logo_200px.png"
  },
  "table_sorting": {
    "combined": {
      "columns": ["Sample", "Plasmid"],
      "ascending": [true, true]
    },
    "verdict": {
      "columns": ["Sample", "Plasmid", "Value"],
      "ascending": [true, true, false]
    },
    "ratio": {
      "columns": ["Sample", "Value"],
      "ascending": [true, false]
    },
    "p_value": {
      "columns": ["Plasmid", "p_value_corrected"],
      "ascending": [true, true]
    }
  },
  "supported_formats": {
    "txt": ".txt",
    "bam": ".bam",
    "fastq": [".fastq", ".fq", ".fastq.gz", ".fq.gz"],
    "fasta": [".fasta", ".fa", ".fna", ".fsa", ".ffn"],
    "genbank": [".gb", ".gbk", ".genbank"],
    "xdna": ".xdna",
    "snapgene": ".dna"
  },
  "retry_settings": {
    "retries": 3,
    "delay": 5
  }
}
